generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// 🧱 RAW LAYER (HAM VERİ)
//
model SurveyRawSubmission {
  id            Int      @id @default(autoincrement())
  submissionId  String   @unique
  payload       Json
  headers       Json?
  receivedAt    DateTime @default(now())

  @@index([submissionId])
}

//
// 🧱 NORMALIZED LAYER (İŞLENMİŞ VERİ)
//
model SurveyResponse {
  id            Int      @id @default(autoincrement())
  submissionId  String   @unique
  answers       Json
  createdAt     DateTime @default(now())

  @@index([submissionId])
}