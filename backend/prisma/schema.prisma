generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SurveySubmission {
  id            String   @id @default(cuid())
  submissionId  String   @unique
  payload       Json
  parsedAnswers Json?
  createdAt     DateTime @default(now())

  @@index([submissionId])
}